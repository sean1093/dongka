---
const { current } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const tabs = [
  ['atlas', '豆子圖鑑', '/atlas/'],
  ['drinks', '飲品配方', '/drinks/'],
  ['glossary', '名詞辭典', '/glossary/'],
];
---
<nav class="subnav" data-pagefind-ignore aria-label="查詢">
  {tabs.map(([k, label, href]) => <a href={`${base}${href}`} class:list={{ on: k === current }} aria-current={k === current ? 'page' : undefined}>{label}</a>)}
</nav>
