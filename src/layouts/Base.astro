---
import '../styles/global.css';
import { site } from '../data/site.js';
// fullTitle：整個 <title> 自己決定（給首頁與需要關鍵字在前的頁面）；jsonld：結構化資料；noindex：不希望被收錄的頁面
import ogList from '../data/og-manifest.json';
// share：頁尾是否顯示分享列；shareText：分享時帶出去的那句話
const { title, fullTitle, description = site.description, jsonld = [], ogType = 'website', noindex = false, share = true, shareText } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const full = fullTitle || (title ? `${title}｜懂咖 Dongka` : '懂咖 Dongka｜咖啡入門自學課：從喜歡喝，到喝得懂');
const path = Astro.url.pathname;
const origin = (Astro.site?.origin || '').replace(/\/$/, '');
const canonical = `${origin}${path.endsWith('/') || path.includes('.') ? path : path + '/'}`;
// 分享圖（scripts/og.mjs 產生）：這一頁自己的 → 所屬類別共用的 → 全站共用的
const ogKey = path.slice(base.length).replace(/^\/|\/$/g, '').replace(/\//g, '--') || 'home';
const ogPages: string[] = (ogList as any).pages || [];
const ogShared: Record<string, string> = (ogList as any).shared || {};
const ogName = ogPages.includes(ogKey) ? ogKey : ogShared[ogKey.split('--')[0]];
// 沒有專屬圖的頁面用首頁那張（og.png 由同一支腳本產生，內容和首頁卡片一致）
const ogImage = `${origin}${base}/og/${ogName || 'home'}.jpg`;
const ld = (Array.isArray(jsonld) ? jsonld : [jsonld]).filter(Boolean);
const nav = [
  { href: `${base}/`, label: '課程', on: path === `${base}/` || path.includes('/lessons/') },
  { href: `${base}/faq/`, label: '速查', on: /\/(faq|compare|cheatsheets)\//.test(path) },
  { href: `${base}/atlas/`, label: '圖鑑', on: /\/(atlas|drinks|glossary)\//.test(path) },
  { href: `${base}/tools/`, label: '工具', on: /\/(tools|practice)\//.test(path) },
];
---
<!doctype html>
<html lang="zh-Hant-TW" data-base={base}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="懂咖 Dongka" />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" type="application/xml" href={`${base}/sitemap.xml`} />
    {site.googleSiteVerification && <meta name="google-site-verification" content={site.googleSiteVerification} />}
    {ld.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <script is:inline>
      try {
        const t = localStorage.getItem('stc:theme');
        if (t) document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">跳到主要內容</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href={`${base}/`}><span aria-hidden="true">☕</span> <span class="brand-t">懂咖 <small>Dongka</small></span></a>
        <nav aria-label="主選單">
          {nav.map((n) => <a href={n.href} class:list={{ on: n.on }} aria-current={n.on ? 'page' : undefined}>{n.label}</a>)}
          <a href={`${base}/search/`} class="icon-btn" aria-label="搜尋" title="搜尋"><svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="6" fill="none" stroke="currentColor" stroke-width="2"/><path d="M13 13l5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></a>
          <button id="theme-btn" class="icon-btn" type="button" aria-label="切換深淺色"><svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="8" fill="none" stroke="currentColor" stroke-width="2"/><path d="M10 2a8 8 0 0 1 0 16z" fill="currentColor"/></svg></button>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
      {share && !noindex && (
        <div class="wrap">
          <div class="share" data-title={shareText || title || site.tagline}>
            <span>覺得有用，分享給也想學咖啡的人</span>
            <button type="button" class="btn btn-sm" data-share="native" hidden>分享</button>
            <button type="button" class="btn btn-sm" data-share="line">LINE</button>
            <button type="button" class="btn btn-sm" data-share="copy">複製連結</button>
          </div>
        </div>
      )}
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <nav class="foot-nav" aria-label="頁尾">
          <a href={`${base}/start/`}>從這裡開始</a>
          <a href={`${base}/practice/plan/`}>練習計畫</a>
          <a href={`${base}/my-data/`}>我的資料</a>
          <a href={`${base}/about/`}>關於</a>
          <a href={`${base}/privacy/`}>隱私權政策</a>
          <a href={`${base}/terms/`}>使用條款</a>
        </nav>
        <p>懂咖（Dongka）從個人的咖啡學習筆記整理而成。{site.checkShort}法規、價格與標準請以官方最新公告為準。</p>
        <p>學習進度與紀錄只存在你的瀏覽器裡，不會上傳。含酒精飲品請適量飲用，未滿 18 歲請勿飲酒。</p>
      </div>
    </footer>
    <script>
      import '../scripts/share.js';
      document.getElementById('theme-btn')?.addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.dataset.theme
          ? root.dataset.theme === 'dark'
          : matchMedia('(prefers-color-scheme: dark)').matches;
        root.dataset.theme = dark ? 'light' : 'dark';
        try { localStorage.setItem('stc:theme', root.dataset.theme); } catch {}
        document.dispatchEvent(new CustomEvent('themechange'));
      });
    </script>
  </body>
</html>
