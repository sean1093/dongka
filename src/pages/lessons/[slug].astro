---
import Base from '../../layouts/Base.astro';
import { stages, lessons, tools } from '../../data/lessons.js';
import { renderLesson } from '../../lib/notion.js';
import { site } from '../../data/site.js';
import { breadcrumb, article } from '../../lib/seo.js';
import { faqs } from '../../data/faq.js';
import { comparisons } from '../../data/compare.js';
import { sheets } from '../../data/cheatsheets.js';

export function getStaticPaths() {
  return lessons.map((l) => ({ params: { slug: l.slug }, props: { lesson: l } }));
}
const { lesson } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const files = import.meta.glob('../../content/lessons/*.md', { query: '?raw', import: 'default', eager: true });
const src = files[`../../content/lessons/${lesson.id}.md`] as string;
if (!src) throw new Error(`找不到第 ${lesson.id} 篇的內容檔`);
const { html, toc, quiz, extra, minutes, coreMinutes } = renderLesson(src, base, lesson);
const stage = stages.find((s) => s.id === lesson.stage)!;
const i = lessons.indexOf(lesson);
const prev = lessons[i - 1];
const next = lessons[i + 1];
const origin = (Astro.site?.origin || '').replace(/\/$/, '');
const lpath = `${base}/lessons/${lesson.slug}/`;
const relSheets = sheets.filter((x) => x.lessons.includes(lesson.id));
const relFaqs = faqs.filter((x) => x.lesson === lesson.id).slice(0, 8);
const relCmps = comparisons.filter((x) => x.lessons.includes(lesson.id)).slice(0, 5);
const advQ: number[] = lesson.advancedQuiz || [];
const hasMermaid = html.includes('class="mermaid"');
const hasAdv = toc.some((t) => t.adv);
// 讀完之後可以馬上動手的工具
const related: Record<string, string[]> = {
  '01': ['label', 'atlas'], '02': ['atlas', 'label'], '03': ['brew-log', 'review'], '04': ['cupping', 'review'],
  '05': ['plan', 'timer', 'troubleshoot', 'extraction'], '06': ['drinks', 'troubleshoot'], '07': ['review', 'glossary'],
  '08': ['drinks', 'timer'], '09': ['review', 'glossary'], '10': ['atlas', 'review'], '11': ['review', 'glossary'], '12': ['review', 'glossary'],
};
const relTools = (related[lesson.id] || []).map((s) => tools.find((t) => t.slug === s)!);
---
<Base
  fullTitle={`${lesson.seoTitle}｜懂咖`}
  description={lesson.seoDesc}
  ogType="article"
  jsonld={[
    breadcrumb(origin, [['懂咖', `${base}/`], [lesson.title, lpath]]),
    article(origin, { headline: lesson.seoTitle, description: lesson.seoDesc, path: lpath }),
  ]}
>
  <div class="read-bar" aria-hidden="true"><i id="read-bar"></i></div>
  <div class="wrap" data-pagefind-body>
    <header class="lesson-head">
      <p class="eyebrow"><a href={`${base}/`}>課程</a> / 階段 {stage.id} {stage.name} / 第 {lesson.id} 篇</p>
      <h1>{lesson.title}</h1>
      <p class="lede">{lesson.lede}</p>
      <p class="meta">
        {coreMinutes < minutes - 2 ? <span>核心約 {coreMinutes} 分鐘，全文約 {minutes} 分鐘</span> : <span>約 {minutes} 分鐘</span>}
        <span>{quiz.length} 題自我檢核</span>
        {hasAdv && <span>含進階段落</span>}
        <span>最後查核 <time datetime={site.updated}>{site.updated}</time></span>
      </p>
    </header>
    <div class="lesson-layout">
      <article class="prose" data-lesson={lesson.id}>
        <div class="takeaways" data-pagefind-ignore>
          <strong>先記住這三件事</strong>
          <ol>{lesson.takeaways.map((t: string) => <li>{t}</li>)}</ol>
        </div>

        <details class="toc-mobile" data-pagefind-ignore>
          <summary>本篇目錄<span id="toc-now"></span></summary>
          <nav>
            {toc.map((t) => <a href={`#${t.id}`}>{t.text}{t.adv && <span class="badge">進階</span>}</a>)}
            {quiz.length > 0 && <a href="#quiz">自我檢核</a>}
          </nav>
        </details>

        {hasAdv && (
          <div class="mode" data-pagefind-ignore>
            <div>
              <strong>第一次讀？</strong>
              <span class="muted">標示「進階」的段落可以先跳過，不影響後面的理解。</span>
            </div>
            <button class="btn btn-sm" id="mode-btn" type="button" aria-pressed="false">收合進階段落</button>
          </div>
        )}

        {lesson.id === '12' ? null : ['09', '10', '11'].includes(lesson.id) && (
          <aside class="callout"><span class="callout-icon" aria-hidden="true">⚖️</span><div class="callout-body"><p>本篇涉及法規、金額與統計數字，資料日期與出處見文末的參考資料。內容是學習用的整理，不是法律、稅務或投資建議，實際決策請以主管機關的最新公告與專業人士的意見為準。</p></div></aside>
        )}
        <Fragment set:html={html} />

        {quiz.length > 0 && (
          <section class="quiz" id="quiz" data-pagefind-ignore>
            <div class="quiz-head">
              <h2>自我檢核</h2>
              <span class="muted" id="quiz-score">0 / {quiz.length} 題已掌握</span>
            </div>
            <p class="muted">先在心裡（或說出口）回答，再看參考答案，然後誠實標記自己答得如何。</p>
            {quiz.map((q, n) => (
              <div class="qcard" data-q={n}>
                <p class="q"><span>{q.label}</span>{advQ.includes(n + 1) && <span class="badge" style="align-self:center;margin:0">進階</span>}<span style="color:inherit;font-family:inherit;flex:1" set:html={q.q} /></p>
                <div class="a" set:html={q.a} />
                <button class="btn btn-sm reveal" type="button">看參考答案</button>
                <div class="rate">
                  <button class="btn btn-sm" type="button" data-rate="ok">✓ 我答對了</button>
                  <button class="btn btn-sm" type="button" data-rate="again">↻ 還要再練</button>
                  <button class="btn btn-sm" type="button" data-rate="hide">收合</button>
                </div>
              </div>
            ))}
            <Fragment set:html={extra} />
          </section>
        )}

        {(relSheets.length + relFaqs.length + relCmps.length) > 0 && (
          <section class="next-do rel-quick" data-pagefind-ignore>
            <h2>這一篇的速查頁</h2>
            {relSheets.length > 0 && <p class="path-links">{relSheets.map((x) => <a href={`${base}/cheatsheets/${x.slug}/`}>{x.title}</a>)}</p>}
            {relCmps.length > 0 && <p class="path-links">{relCmps.map((x) => <a href={`${base}/compare/${x.slug}/`}>{x.title.replace(/？$/, '')}</a>)}</p>}
            {relFaqs.length > 0 && <ul class="rel-terms">{relFaqs.map((x) => <li><a href={`${base}/faq/${x.slug}/`}>{x.q}</a></li>)}</ul>}
          </section>
        )}

        {relTools.length > 0 && (
          <section class="next-do" data-pagefind-ignore>
            <h2>讀完了，接著做</h2>
            <div class="grid grid-2">
              {relTools.map((t) => (
                <a class="card tool-card" href={`${base}${t.path}`}>
                  <span class="ico" aria-hidden="true">{t.icon}</span>
                  <h3>{t.title}</h3>
                  <p>{t.desc}</p>
                </a>
              ))}
            </div>
          </section>
        )}

        <div class="lesson-end" data-pagefind-ignore>
          <button class="btn btn-primary" id="done-btn" type="button">標記這篇為已完成</button>
          <span><a href={site.issuesUrl} rel="noopener">回報這篇的錯誤</a>　<a href={`${base}/`}>回課程總覽</a></span>
        </div>
        <nav class="pager" aria-label="上下篇" data-pagefind-ignore>
          {prev && <a href={`${base}/lessons/${prev.slug}/`}><small>← 上一篇</small>{prev.id} {prev.title}</a>}
          {next && <a class="next" href={`${base}/lessons/${next.slug}/`}><small>下一篇 →</small>{next.id} {next.title}</a>}
        </nav>
      </article>

      <aside class="toc" aria-label="本篇目錄" data-pagefind-ignore>
        <strong>本篇目錄</strong>
        {toc.map((t) => <a href={`#${t.id}`}>{t.text}{t.adv && <span class="badge">進階</span>}</a>)}
        {quiz.length > 0 && <a href="#quiz">自我檢核</a>}
      </aside>
    </div>
  </div>
  <div class="term-pop" id="term-pop" role="tooltip" hidden></div>
  {hasMermaid && (
    <script>
      // 流程圖用到的程式很大：等圖快進入畫面才載入，並跟著深淺色重畫
      const pres = [...document.querySelectorAll<HTMLElement>('pre.mermaid')];
      pres.forEach((p) => (p.dataset.src = p.textContent || ''));
      const isDark = () => document.documentElement.dataset.theme
        ? document.documentElement.dataset.theme === 'dark'
        : matchMedia('(prefers-color-scheme: dark)').matches;
      let lib: any = null;
      async function draw() {
        lib ||= (await import('mermaid')).default;
        pres.forEach((p) => { p.textContent = p.dataset.src!; p.removeAttribute('data-processed'); });
        lib.initialize({ startOnLoad: false, theme: isDark() ? 'dark' : 'neutral', securityLevel: 'strict', fontFamily: 'system-ui, sans-serif' });
        await lib.run({ nodes: pres });
        pres.forEach((p) => p.querySelector('svg')?.setAttribute('aria-label', '流程圖：' + p.dataset.src!.replace(/<br\s*\/?>/g, ' ').match(/"[^"]+"/g)?.map((x) => x.slice(1, -1)).join('、')));
      }
      const io = new IntersectionObserver((es) => { if (es.some((e) => e.isIntersecting)) { io.disconnect(); draw(); } }, { rootMargin: '800px' });
      pres.forEach((p) => io.observe(p));
      document.addEventListener('themechange', () => { if (lib) draw(); });
    </script>
  )}
</Base>

<script>
  import { load, save, getDone, setDone } from '../../scripts/store.js';
  import { openTerm } from '../../scripts/term-panel.js';
  const article = document.querySelector<HTMLElement>('article[data-lesson]')!;
  const id = article.dataset.lesson!;

  // 完成標記
  const btn = document.getElementById('done-btn')!;
  const paint = () => {
    const on = getDone().includes(id);
    btn.classList.toggle('done', on);
    btn.classList.toggle('btn-primary', !on);
    btn.textContent = on ? '✓ 已完成（點一下取消）' : '標記這篇為已完成';
  };
  btn.addEventListener('click', () => { setDone(id, !getDone().includes(id)); paint(); });
  paint();

  // 自我檢核
  const state: Record<string, string> = load(`quiz:${id}`, {});
  const cards = [...document.querySelectorAll<HTMLElement>('.qcard')];
  const score = document.getElementById('quiz-score');
  const paintQuiz = () => {
    cards.forEach((c) => { c.dataset.state = state[c.dataset.q!] || ''; });
    if (score) score.textContent = `${cards.filter((c) => c.dataset.state === 'ok').length} / ${cards.length} 題已掌握`;
  };
  cards.forEach((c) => {
    c.querySelector('.reveal')!.addEventListener('click', () => c.classList.add('open'));
    c.querySelectorAll<HTMLElement>('[data-rate]').forEach((b) =>
      b.addEventListener('click', () => {
        if (b.dataset.rate !== 'hide') { state[c.dataset.q!] = b.dataset.rate!; save(`quiz:${id}`, state); }
        c.classList.remove('open');
        paintQuiz();
      })
    );
  });
  paintQuiz();

  // 進階段落：整體收合，或逐段展開
  const modeBtn = document.getElementById('mode-btn');
  // 進階段落的標題包成按鈕，鍵盤與螢幕閱讀器也能展開（#7）
  const advHeads = [...document.querySelectorAll<HTMLElement>('.sec[data-adv] > h2')];
  const syncAdv = () => advHeads.forEach((h) => {
    const b = h.querySelector('.adv-toggle');
    if (!b) return;
    const core = article.classList.contains('core-only');
    b.setAttribute('aria-expanded', String(!core || h.parentElement!.classList.contains('open')));
    if (core) b.removeAttribute('tabindex'); else b.setAttribute('tabindex', '-1');
  });
  advHeads.forEach((h) => {
    const b = document.createElement('button');
    b.type = 'button';
    b.className = 'adv-toggle';
    while (h.firstChild) b.append(h.firstChild);
    h.append(b);
    b.addEventListener('click', () => {
      if (!article.classList.contains('core-only')) return;
      h.parentElement!.classList.toggle('open');
      syncAdv();
    });
  });
  const setMode = (core: boolean) => {
    article.classList.toggle('core-only', core);
    document.querySelectorAll('.sec[data-adv]').forEach((s) => s.classList.remove('open'));
    if (modeBtn) { modeBtn.setAttribute('aria-pressed', String(core)); modeBtn.textContent = core ? '展開進階段落' : '收合進階段落'; }
    syncAdv();
  };
  modeBtn?.addEventListener('click', () => { const core = !article.classList.contains('core-only'); save('coreOnly', core); setMode(core); });
  // 手機上第一次造訪時預設收合進階段落，文章短很多；選擇過就照使用者的
  if (modeBtn) setMode(load('coreOnly', matchMedia('(max-width: 960px)').matches));
  syncAdv();
  // 從目錄或連結跳到被收合的段落時自動展開
  const openTarget = () => {
    let t: Element | null = null;
    try { if (location.hash.length > 1) t = document.querySelector(location.hash); } catch {}
    t?.closest('.sec[data-adv]')?.classList.add('open');
    syncAdv();
  };
  addEventListener('hashchange', openTarget);
  openTarget();
  document.querySelector<HTMLDetailsElement>('.toc-mobile')?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) (e.currentTarget as HTMLDetailsElement).open = false;
  });

  // 名詞解釋
  const pop = document.getElementById('term-pop')!;
  let cur: HTMLElement | null = null;
  const hide = () => { pop.hidden = true; cur = null; };
  document.addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest<HTMLElement>('.term');
    if ((e.target as HTMLElement).closest('.tp-more')) { const name = cur?.dataset.term; hide(); if (name) openTerm(name); return; }
    if (t && ((e as MouseEvent).metaKey || (e as MouseEvent).ctrlKey)) return; // 另開分頁時照一般連結處理
    if (t) e.preventDefault();
    if (!t || t === cur) return hide();
    // 桌機：直接開右側面板（不遮內文）；手機：先給一句話，想看再展開
    if (matchMedia('(min-width: 961px)').matches) { hide(); openTerm(t.dataset.term); return; }
    cur = t;
    pop.innerHTML = `<b></b> <small></small><p></p><button type="button" class="tp-more">完整說明 →</button>`;
    pop.querySelector('b')!.textContent = t.dataset.term!;
    pop.querySelector('small')!.textContent = t.dataset.en!;
    pop.querySelector('p')!.textContent = t.dataset.def!;
    pop.hidden = false;
    const r = t.getBoundingClientRect();
    const w = pop.offsetWidth;
    pop.style.left = `${Math.max(12, Math.min(innerWidth - w - 12, r.left + r.width / 2 - w / 2)) + scrollX}px`;
    const above = r.top > pop.offsetHeight + 16;
    pop.style.top = `${(above ? r.top - pop.offsetHeight - 8 : r.bottom + 8) + scrollY}px`;
  });
  addEventListener('keydown', (e) => e.key === 'Escape' && hide());
  addEventListener('resize', hide);

  // 閱讀進度與目錄高亮
  const bar = document.getElementById('read-bar')!;
  const onScroll = () => {
    const r = article.getBoundingClientRect();
    const p = Math.min(1, Math.max(0, -r.top / (r.height - innerHeight)));
    bar.style.width = `${p * 100}%`;
  };
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
  const io = new IntersectionObserver(
    (es) => es.forEach((e) => {
      if (e.isIntersecting) {
        links.forEach((a) => a.classList.toggle('on', a.hash === `#${e.target.id}`));
        const now = document.getElementById('toc-now');
        const t = e.target.id === 'quiz' ? '自我檢核' : (e.target.textContent || '').replace('進階', '').trim();
        if (now) now.textContent = ` · ${t}`;
      }
    }),
    { rootMargin: '-80px 0px -70% 0px' }
  );
  document.querySelectorAll('.prose h2[id], #quiz').forEach((h) => io.observe(h));
</script>
