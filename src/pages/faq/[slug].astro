---
import Base from '../../layouts/Base.astro';
import RefNav from '../../components/RefNav.astro';
import { faqs } from '../../data/faq.js';
import { lessons } from '../../data/lessons.js';
import { glossary } from '../../data/glossary.js';
import { comparisons } from '../../data/compare.js';
import { slugify, site } from '../../data/site.js';
import { breadcrumb, article } from '../../lib/seo.js';

export function getStaticPaths() {
  return faqs.map((f) => ({ params: { slug: f.slug }, props: { f } }));
}
const { f } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const origin = (Astro.site?.origin || '').replace(/\/$/, '');
const lesson = lessons.find((l) => l.id === f.lesson)!;
const related = f.related.map((s: string) => faqs.find((x) => x.slug === s)).filter(Boolean);
const terms = (f.terms || []).map((t: string) => glossary.find((g) => g.term === t)).filter(Boolean);
const comps = comparisons.filter((c) => c.lessons.includes(f.lesson)).slice(0, 2);
const path = `${base}/faq/${f.slug}/`;
---
<Base
  fullTitle={`${f.q.replace(/？$/, '')}？｜咖啡常見問題｜懂咖`}
  description={f.short}
  ogType="article"
  shareText={`${f.q} ${f.short}`}
  jsonld={[breadcrumb(origin, [['懂咖', `${base}/`], ['常見問題', `${base}/faq/`], [f.q, path]]), article(origin, { headline: f.q, description: f.short, path })]}
>
  <div class="wrap narrow" data-pagefind-body>
    <header class="tool-head">
      <p class="eyebrow"><a href={`${base}/faq/`}>常見問題</a> / {f.group}</p>
      <h1 data-pagefind-weight="8">{f.q}</h1>
    </header>
    <article class="prose">
      <div class="answer">
        <p>{f.short}</p>
        <div class="answer-share" data-pagefind-ignore>
          <button type="button" class="btn btn-sm" data-share="native" hidden>分享這一題</button>
          <button type="button" class="btn btn-sm" data-share="line">傳這一題到 LINE</button>
          <button type="button" class="btn btn-sm" data-copy={`${f.q}\n${f.short}`}>複製回答與連結</button>
        </div>
      </div>
      {f.body.map((p: string) => <p>{p}</p>)}
      {f.points.length > 0 && <ul class="points">{f.points.map((p: string) => <li>{p}</li>)}</ul>}
      <p class="src" data-pagefind-ignore>依據：<a href={`${base}/lessons/${lesson.slug}/`}>第 {lesson.id} 篇　{lesson.title}</a>「{f.section.replace(/^\d+\.\s*/, '')}」一節。最後查核 {site.updated}。</p>

      {terms.length > 0 && (
        <>
          <h2 class="h-sm" style="margin-top:1.8em" data-pagefind-ignore>提到的名詞</h2>
          <ul class="rel-terms" data-pagefind-ignore>{terms.map((t: any) => <li><a href={`${base}/glossary/${slugify(t.en)}/`}>{t.term}</a>：{t.def}</li>)}</ul>
        </>
      )}
      {related.length > 0 && (
        <>
          <h2 class="h-sm" style="margin-top:1.8em" data-pagefind-ignore>接著可能想問</h2>
          <ul class="rel-terms" data-pagefind-ignore>{related.map((r: any) => <li><a href={`${base}/faq/${r.slug}/`}>{r.q}</a></li>)}</ul>
        </>
      )}
      {comps.length > 0 && (
        <>
          <h2 class="h-sm" style="margin-top:1.8em" data-pagefind-ignore>相關比較</h2>
          <ul class="rel-terms" data-pagefind-ignore>{comps.map((c) => <li><a href={`${base}/compare/${c.slug}/`}>{c.title}</a></li>)}</ul>
        </>
      )}
    </article>
    <RefNav current="faq" />
  </div>
</Base>
