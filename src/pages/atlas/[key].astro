---
import Base from '../../layouts/Base.astro';
import SubNav from '../../components/SubNav.astro';
import { flavorTags, origins, processes } from '../../data/atlas.js';
import { site } from '../../data/site.js';
import { breadcrumb, article } from '../../lib/seo.js';
import { hasOriginPage as eligible } from '../../lib/origin-pages.js';

export function getStaticPaths() {
  return origins.filter(eligible).map((o) => ({ params: { key: o.key }, props: { o } }));
}
const { o } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const org = (Astro.site?.origin || '').replace(/\/$/, '');
const tag = Object.fromEntries(flavorTags.map((t) => [t.key, t.label]));
const procs = o.processes.map((k: string) => processes.find((p) => p.key === k)).filter(Boolean);
const others = origins.filter((x) => x.key !== o.key && x.flavors.length);
const link = (x: any) => (eligible(x) ? `${base}/atlas/${x.key}/` : `${base}/atlas/#o-${x.key}`);
// 風味相近：共同風味標籤最多；風格相反：酸質與醇厚度差距最大
const similar = others.map((x) => ({ x, n: x.flavors.filter((f: string) => o.flavors.includes(f)).length })).filter((s) => s.n > 0).sort((a, b) => b.n - a.n).slice(0, 3).map((s) => s.x);
const opposite = [...others].sort((a, b) => (Math.abs(b.acidity - o.acidity) + Math.abs(b.body - o.body)) - (Math.abs(a.acidity - o.acidity) + Math.abs(a.body - o.body)))[0];
const lvl = (v: number, lo: string, mid: string, hi: string) => (v >= 4 ? hi : v <= 2 ? lo : mid);
const sameRegion = origins.filter((x) => x.region === o.region && x.key !== o.key && eligible(x));
const hasFruity = o.processes.some((k: string) => ['natural', 'anaerobic', 'carbonic', 'honey'].includes(k));
const titleFlavors = o.flavors.slice(0, 2).map((f: string) => tag[f].split('、')[0]).join('、');
const flavorText = o.flavors.map((f: string) => tag[f]).join('、');
const path = `${base}/atlas/${o.key}/`;
const desc = `${o.name}咖啡豆是什麼味道？${o.summary}。典型風味：${flavorText}。整理${o.name}的著名產區、常見處理法、適合的烘焙度，以及和其他產區的差別。`.slice(0, 155);
const bar = (label: string, v: number) => `<span class="mbar"><i>${label}</i><b style="--v:${v}"></b></span>`;
---
<Base
  fullTitle={`${o.name}咖啡豆是什麼味道？${titleFlavors}｜產區風味與挑選｜懂咖`}
  description={desc}
  ogType="article"
  shareText={`${o.name}咖啡豆是什麼味道？${o.summary}`}
  jsonld={[breadcrumb(org, [['懂咖', `${base}/`], ['豆子圖鑑', `${base}/atlas/`], [o.name, path]]), article(org, { headline: `${o.name}咖啡豆的風味與特色`, description: desc, path })]}
>
  <div class="wrap narrow" data-pagefind-body>
    <header class="tool-head">
      <p class="eyebrow"><a href={`${base}/atlas/`}>豆子圖鑑</a> / {o.region}</p>
      <h1 data-pagefind-weight="8">{o.name}咖啡豆是什麼味道？</h1>
      <p class="lede">{o.summary}。</p>
    </header>
    <SubNav current="atlas" />
    <article class="prose">
      <div class="answer">
        <p>{o.name}的典型印象是{flavorText}，酸質{lvl(o.acidity, '偏低', '中等', '明亮')}，口感{lvl(o.body, '輕盈', '中等', '厚實')}。</p>
        <div class="mbars" set:html={bar('酸質', o.acidity) + bar('醇厚', o.body) + bar('甜感', o.sweetness)} />
      </div>
      <p>{o.notes}</p>
      <dl class="afacts" style="font-size:.95rem">
        {o.areas.length > 0 && <><dt>著名產區</dt><dd>{o.areas.join('、')}</dd></>}
        {o.varieties.length > 0 && <><dt>常見品種</dt><dd>{o.varieties.join('、')}</dd></>}
        {o.altitude && <><dt>海拔</dt><dd>{o.altitude}</dd></>}
      </dl>

      {procs.length > 0 && (
        <>
          <h2 class="h-sm" style="margin-top:1.8em">常見的處理法會怎麼改變它</h2>
          <ul class="rel-terms" data-pagefind-ignore>{procs.map((p: any) => <li><b>{p.name}</b>：{p.effect}</li>)}</ul>
        </>
      )}

      <h2 class="h-sm" style="margin-top:1.8em">挑豆與沖煮的起點</h2>
      <p>萃取的難易主要看烘焙度，其次是處理法，產區本身決定不了。同一個產區的豆子，烘豆商可以烘得很淺，也可以烘得很深，所以請先看豆袋。</p>
      <ul class="points">
        <li>淺焙：密度高、不易萃取，用較高的水溫（93 至 96°C）並稍微磨細。</li>
        <li>中焙：用通用配方就能有不錯的結果。</li>
        <li>中深焙以上：容易萃取、苦味物質多，水溫降到 85 至 90°C、研磨稍粗。</li>
        {hasFruity && <li>這個產區常見日曬或蜜處理：香氣外放、容易出現酒感，水溫稍降到 90 至 92°C，並控制總時間。</li>}
        <li>標籤上先看處理法：同一個產區，水洗和日曬的味道可以差很多。</li>
      </ul>
      <p class="muted" style="font-size:.9rem">依據<a href={`${base}/lessons/brewing/`}>第 05 篇</a>「依豆子調整萃取」一節。</p>

      <h2 class="h-sm" style="margin-top:1.8em" data-pagefind-ignore>和其他產區比</h2>
      <ul class="rel-terms" data-pagefind-ignore>
        {similar.map((x: any) => <li>風味相近：<a href={link(x)}>{x.name}</a>，{x.summary}</li>)}
        {opposite && <li>風格相反：<a href={link(opposite)}>{opposite.name}</a>，{opposite.summary}</li>}
      </ul>

      {sameRegion.length > 0 && (
        <>
          <h2 class="h-sm" style="margin-top:1.8em" data-pagefind-ignore>{o.region}的其他產區</h2>
          <p class="path-links" data-pagefind-ignore>{sameRegion.map((x) => <a href={`${base}/atlas/${x.key}/`}>{x.name}</a>)}</p>
        </>
      )}

      <p class="src" data-pagefind-ignore>依據：<a href={`${base}/lessons/origins/`}>第 02 篇　產區巡禮</a>與<a href={`${base}/lessons/beans/`}>第 01 篇　咖啡豆</a>。這裡寫的是典型印象，酸質與醇厚的分數是依課文描述推估的。最後查核 {site.updated}。</p>
      <p><a href={`${base}/practice/label/`}>用標籤練習測試你的判斷 →</a></p>
    </article>
  </div>
</Base>
