---
import Base from '../layouts/Base.astro';
import SubNav from '../components/SubNav.astro';
import { glossary } from '../data/glossary.js';
const groups = [...new Set(glossary.map((g) => g.group))];
---
<Base title="名詞辭典" description="咖啡常見名詞的白話解釋：豆子、處理、烘焙、品飲、沖煮、義式與產業。">
  <div class="wrap" data-pagefind-body>
    <header class="tool-head">
      <p class="eyebrow">查詢</p>
      <h1>名詞辭典</h1>
      <p class="muted">{glossary.length} 個名詞。點任何一個看完整說明、相關名詞，以及它出現在哪幾篇。</p>
    </header>
    <SubNav current="glossary" />
    <div class="filters" data-pagefind-ignore>
      <label class="filter">搜尋<input id="gq" type="search" placeholder="輸入中文或英文，例如：萃取、bloom" autocomplete="off" /></label>
      <div class="chips" id="gg" role="group" aria-label="分類">
        <button class="chip" type="button" data-v="" aria-pressed="true">全部</button>
        {groups.map((g) => <button class="chip" type="button" data-v={g} aria-pressed="false">{g}</button>)}
      </div>
    </div>
    <div class="grid gloss-grid" id="glist">
      {glossary.map((g) => (
        <button class="gcard" type="button" data-term={g.term} data-group={g.group} data-k={`${g.term} ${g.en} ${(g.alias || []).join(' ')}`.toLowerCase()}>
          <span class="gt">{g.term} <small>{g.en}</small></span>
          <span class="gd">{g.def}</span>
          <span class="gg">{g.group}</span>
        </button>
      ))}
    </div>
    <p class="empty" id="gnone" hidden>找不到符合的名詞。</p>
  </div>
</Base>

<script>
  import { openTerm } from '../scripts/term-panel.js';
  const q = document.getElementById('gq') as HTMLInputElement;
  const cards = [...document.querySelectorAll<HTMLElement>('.gcard')];
  let group = '';
  const apply = () => {
    const v = q.value.trim().toLowerCase();
    let n = 0;
    cards.forEach((c) => { const ok = (!group || c.dataset.group === group) && (!v || c.dataset.k!.includes(v)); c.hidden = !ok; if (ok) n++; });
    document.getElementById('gnone')!.hidden = n > 0;
  };
  q.addEventListener('input', apply);
  document.getElementById('gg')!.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('.chip');
    if (!b) return;
    group = b.dataset.v!;
    document.querySelectorAll('#gg .chip').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    apply();
  });
  document.getElementById('glist')!.addEventListener('click', (e) => {
    const c = (e.target as HTMLElement).closest<HTMLElement>('.gcard');
    if (c) { openTerm(c.dataset.term); history.replaceState(null, '', `#${encodeURIComponent(c.dataset.term!)}`); }
  });
  document.addEventListener('term:open', (e) => { document.body.classList.add('with-panel'); cards.forEach((c) => c.classList.toggle('on', c.dataset.term === (e as CustomEvent).detail)); });
  document.addEventListener('term:close', () => { document.body.classList.remove('with-panel'); cards.forEach((c) => c.classList.remove('on')); history.replaceState(null, '', location.pathname); });
  if (location.hash.length > 1) openTerm(decodeURIComponent(location.hash.slice(1)));
</script>
