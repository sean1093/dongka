---
import Base from '../layouts/Base.astro';
import { stages, lessons, tools } from '../data/lessons.js';
import { journey } from '../lib/figures.js';
import { website } from '../lib/seo.js';
const origin = (Astro.site?.origin || '').replace(/\/$/, '');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const L = (id: string) => lessons.find((l) => l.id === id)!;
// 依使用者需求排的入口（#15）：用讀者自己的話當標籤
const entries = [
  ['☕', '我剛拿到手沖器材，想沖第一杯', '一頁照著做，沒有秤也可以', '/first-cup/'],
  ['🎯', '我在吧台工作，義式味道不對', '輸入粉量、液重、秒數，告訴你先調什麼', '/tools/espresso/'],
  ['🌙', '我每天喝，想知道喝了多少咖啡因', '把今天喝的加起來，和官方參考值並列', '/tools/caffeine/'],
  ['📈', '我想把豆子沖得更準', '萃取率、沖煮紀錄、杯測與計時器', '/tools/'],
  ['🎓', '我想轉行做咖啡，要考什麼證照', '丙級、乙級的資格與時程，比賽怎麼參加', '/career/'],
  ['🏪', '我想開咖啡館，先算會不會賺', '損益平衡試算與開店前的法規清單', '/tools/break-even/'],
  ['🫘', '我想看懂豆子標籤與咖啡店菜單', '六條不用從頭讀到尾的入門路線', '/start/'],
  ['❓', '我有具體的問題，直接查', '每題先用一兩句話回答', '/faq/'],
];

---
<Base jsonld={website(origin, import.meta.env.BASE_URL.replace(/\/$/, ''))}>
  <section class="hero wrap">
    <p class="eyebrow">懂咖 Dongka · 咖啡自學課 {lessons.length} 篇</p>
    <h1>從喜歡喝，到喝得懂</h1>
    <p class="lead">給喜歡喝咖啡、想知道「為什麼」的人。從種子到杯子，每一篇都從你喝得到的差異講起。</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href={`${base}/first-cup/`}>照著做第一杯手沖</a>
      <a class="btn" href={`${base}/start/`}>不知道從哪開始？</a>
    </div>
    <p class="hero-sub"><a id="resume" href={`${base}/lessons/${lessons[0].slug}/`}>或從第 01 篇開始讀完整課程</a></p>
    <div class="progress" id="progress" hidden>
      <div class="progress-bar"><i id="pbar"></i></div>
      <small id="ptext">已完成 0 / {lessons.length} 篇</small>
    </div>
  </section>

  <section class="wrap" id="paths">
    <h2 class="section-title">我想……</h2>
    <nav aria-label="我想做什麼">
      <ul class="want-list">
        {entries.map(([icon, label, hint, href]) => (
          <li><a href={`${base}${href}`}><span class="ico" aria-hidden="true">{icon}</span><span><b>{label}</b><small>{hint}</small></span></a></li>
        ))}
      </ul>
    </nav>
  </section>

  <section class="wrap">
    <h2 class="section-title">有問題，先查</h2>
    <p class="muted" style="margin:0 0 20px">不想讀長文的時候，直接看答案。</p>
    <div class="grid grid-2">
      {[['❓', '常見問題', '養豆幾天、水溫幾度、太酸太苦怎麼辦。每題先用一兩句話回答。', '/faq/'], ['⚖️', '比一比', '水洗和日曬、淺焙和深焙、拿鐵和馥列白，一張表並排看。', '/compare/'], ['📋', '速查表', '手沖參數、味道排查、養豆保存、飲品比例，一頁一張可列印。', '/cheatsheets/']].map(([icon, t, d, href]) => (
        <a class="card tool-card" href={`${base}${href}`}>
          <span class="ico" aria-hidden="true">{icon}</span>
          <h3>{t}</h3>
          <p>{d}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="wrap">
    <h2 class="section-title">完整課程</h2>
    <p class="muted" style="margin:0 0 20px">照順序讀效果最好。每篇開頭有三個重點，標示「進階」的段落第一次可以先跳過。</p>
    <div class="journey-wrap" set:html={journey()} />
    {stages.map((s) => (
      <div class="stage">
        <div class="stage-head">
          <span class="num">階段 {s.id}</span>
          <h3>{s.name}</h3>
          <p>{s.ability}</p>
        </div>
        <div class="lesson-list">
          {lessons.filter((l) => l.stage === s.id).map((l) => (
            <a class="lesson-link" data-lesson={l.id} href={`${base}/lessons/${l.slug}/`}>
              <span class="no">{l.id}</span>
              <span class="t">{l.title}<small>{l.lede}</small></span>
              <span class="check" aria-hidden="true"></span>
            </a>
          ))}
        </div>
      </div>
    ))}
  </section>

  <section class="wrap">
    <h2 class="section-title">沖煮工具</h2>
    <p class="muted" style="margin:0 0 20px">站在秤和水壺旁邊就能用。</p>
    <div class="grid grid-2">
      {tools.filter((t) => t.kind === 'tool').map((t) => (
        <a class="card tool-card" href={`${base}${t.path}`}>
          <span class="ico" aria-hidden="true">{t.icon}</span>
          <h3>{t.title}</h3>
          <p>{t.desc}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="wrap">
    <h2 class="section-title">查詢與練習</h2>
    <p class="muted" style="margin:0 0 20px">不想讀長文的時候，直接查、直接練。</p>
    <div class="grid grid-2">
      {tools.filter((t) => t.kind !== 'tool').map((t) => (
        <a class="card tool-card" href={`${base}${t.path}`}>
          <span class="ico" aria-hidden="true">{t.icon}</span>
          <h3>{t.title}</h3>
          <p>{t.desc}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="wrap narrow" style="margin-top:56px">
    <aside class="callout">
      <span class="callout-icon" aria-hidden="true">🧪</span>
      <div class="callout-body">
        <p><b>建議搭配練習</b>：準備手沖壺、濾杯、磨豆機、電子秤（精度 0.1g）與溫度計，並固定一支中淺焙的衣索比亞水洗豆與一支中焙的巴西日曬豆作為「基準豆」，之後每學一個主題都用這兩支豆子實驗對照。</p>
      </div>
    </aside>
  </section>
</Base>

<script>
  import { getDone } from '../scripts/store.js';
  const done = getDone();
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-lesson]')];
  links.forEach((a) => {
    const on = done.includes(a.dataset.lesson!);
    a.classList.toggle('done', on);
    a.querySelector('.check')!.textContent = on ? '✓' : ''; // 未完成時不輸出 ✓，高對比模式才不會全部顯示
  });
  const n = links.filter((a) => a.classList.contains('done')).length;
  (document.getElementById('pbar') as HTMLElement).style.width = `${(n / links.length) * 100}%`;
  document.getElementById('ptext')!.textContent = `已完成 ${n} / ${links.length} 篇`;
  const next = links.find((a) => !a.classList.contains('done'));
  if (n > 0) (document.getElementById('progress') as HTMLElement).hidden = false;
  const resume = document.getElementById('resume') as HTMLAnchorElement;
  if (n > 0 && next) {
    resume.href = next.href;
    resume.textContent = `繼續第 ${next.dataset.lesson} 篇`;
  } else if (n > 0) {
    resume.textContent = '全部完成，再複習一次';
  }
</script>
