  .log-item.is-editing { background: var(--accent-soft); margin-inline: -10px; padding-inline: 10px; border-radius: 8px; }
  .bl-cmp-wrap { margin: 0; }
  .bl-cmp-wrap:focus-visible { outline: 2px solid var(--accent); }
  table.bl-cmp { font-size: .88rem; }
  table.bl-cmp th, table.bl-cmp td { white-space: nowrap; padding: 6px 10px; text-align: left; }
  table.bl-cmp td.bl-next { white-space: normal; min-width: 12em; }
  table.bl-cmp tr.is-best td { background: var(--accent-soft); font-weight: 600; }
  .bl-best { display: inline-block; font-size: .72rem; padding: 0 6px; border-radius: 99px; background: var(--accent); color: var(--surface); font-weight: 700; }
</style>
