---
import Base from '../../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base fullTitle="開咖啡店一天要賣幾杯才打平？損益平衡計算器｜懂咖" description="輸入月租、人事、其他固定成本、客單價、毛利率或每杯變動成本與營業天數，算出咖啡店每月要多少營業額、每天要幾位客人、賣幾杯才不虧，並列出完整算式方便核對。">
  <div class="wrap" data-pagefind-body>
    <header class="tool-head">
      <p class="eyebrow">工具</p>
      <h1>開店損益平衡計算器</h1>
      <p class="muted">損益平衡是收入剛好等於成本、不賺不虧的點。算法和<a href={`${base}/lessons/career/#s5`}>第 11 篇〈損益平衡：一天要賣幾杯〉</a>相同：固定成本 ÷ 每位客人貢獻的毛利 ÷ 營業天數，人數無條件進位。</p>
    </header>
    <div class="tool-layout be">
      <form class="card grid" id="f" onsubmit="return false" novalidate>
        <div class="chips">
          <button class="btn btn-sm" type="button" id="demo">用示範數字</button>
          <button class="btn btn-sm" type="button" id="clear">清空</button>
        </div>
        <p class="muted note" id="demo-note" hidden>目前是<b>示範數字</b>，取自第 11 篇的例子，不是業界平均。課文只給固定成本合計 30 萬元，沒有拆分，所以整筆放在「其他月固定成本」。請換成你自己的數字。</p>
        <fieldset>
          <legend>每月固定成本</legend>
          <div class="grid be-fields">
            <label>月租（元）<input id="rent" type="number" inputmode="decimal" min="0" step="1000" aria-describedby="rent-err" /></label>
            <p class="err" id="rent-err"></p>
            <label>月人事，含勞健保與老闆自己的薪水（元）<input id="staff" type="number" inputmode="decimal" min="0" step="1000" aria-describedby="staff-err" /></label>
            <p class="err" id="staff-err"></p>
            <label>其他月固定成本：水電、耗材、折舊攤提等（元）<input id="other" type="number" inputmode="decimal" min="0" step="1000" aria-describedby="other-err" /></label>
            <p class="err" id="other-err"></p>
          </div>
        </fieldset>
        <fieldset>
          <legend>客人與毛利</legend>
          <div class="grid be-fields">
            <label>平均客單價（元）<input id="p" type="number" inputmode="decimal" min="0" step="1" aria-describedby="p-err" /></label>
            <p class="err" id="p-err"></p>
            <label>每位客人平均買幾杯（杯）<input id="cups" type="number" inputmode="decimal" min="0" step="0.1" placeholder="不確定先填 1" aria-describedby="cups-hint cups-err" /></label>
            <p class="muted note" id="cups-hint">不確定先填 1。只用來換算「每天幾杯」。</p>
            <p class="err" id="cups-err"></p>
          </div>
        </fieldset>
        <fieldset>
          <legend>毛利怎麼算（二選一）</legend>
          <div class="chips">
            <label class="chip-radio"><input type="radio" name="mode" value="gm" checked /> 用毛利率</label>
            <label class="chip-radio"><input type="radio" name="mode" value="vc" /> 用每杯變動成本</label>
          </div>
          <label id="gm-wrap" style="margin-top:10px">平均毛利率，扣除原物料後（%）<input id="gm" type="number" inputmode="decimal" min="1" max="99" step="1" aria-describedby="gm-err" /></label>
          <p class="err" id="gm-err"></p>
          <label id="vc-wrap" hidden style="margin-top:10px">每杯變動成本：豆、牛奶、杯子等（元／杯）<input id="vc" type="number" inputmode="decimal" min="0" step="1" aria-describedby="vc-err" /></label>
          <p class="err" id="vc-err"></p>
        </fieldset>
        <label>每月營業天數（天）<input id="days" type="number" inputmode="numeric" min="1" max="31" step="1" aria-describedby="days-err" /></label>
        <p class="err" id="days-err"></p>
      </form>

      <div class="card">
        <div class="stat">
          <div><b id="o-rev">–</b><span>每月需要的營業額</span></div>
          <div><b id="o-cust">–</b><span>每天需要的客人</span></div>
          <div><b id="o-cups">–</b><span>每天需要賣的杯數</span></div>
        </div>
        <div class="verdict" id="out" aria-live="polite"></div>
        <pre class="be-formula" id="formula" hidden></pre>
        <p class="muted note">數字只是試算，實際請請會計師或財務人員核對。每天 119 位這類數字只是「不虧」的門檻，不是會賺錢的保證。</p>
        <div class="chips" style="margin-top:12px">
          <button class="btn btn-sm" type="button" id="copy">複製這組數字的連結</button>
        </div>
        <p class="muted note" id="copy-msg" role="status">網址裡就是你填的數字，沒有任何資料上傳。</p>

        <h2 class="h-sm" style="margin-top:22px">我的情境</h2>
        <p class="muted note" style="margin-top:0">存在這台裝置的瀏覽器裡，最多 10 組，可以在<a href={`${base}/my-data/`}>我的資料</a>備份。</p>
        <div class="be-save">
          <label>情境名稱<input id="sc-name" type="text" maxlength="40" placeholder="例如：巷口外帶站、租金 6 萬" /></label>
          <button class="btn btn-primary btn-sm" type="button" id="sc-save">儲存這組情境</button>
        </div>
        <p class="note" id="sc-msg" role="status"></p>
        <ul class="be-list" id="sc-list"></ul>
      </div>
    </div>
  </div>
</Base>

<style is:global>
  .be fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }
  .be legend { font-weight: 700; padding: 0; margin-bottom: 8px; }
  .be-fields { gap: 4px 16px; }
  .be-fields label { margin-top: 6px; }
  .be .note { font-size: .84rem; margin: 6px 0 0; }
  .be .err { color: var(--accent); font-size: .85rem; font-weight: 600; margin: 4px 0 0; }
  .be .err:empty { display: none; }
  .be .chip-radio { position: relative; display: inline-flex; align-items: center; border: 1px solid var(--line); background: var(--surface); color: var(--text); font-size: .92rem; font-weight: 600; padding: 8px 14px; border-radius: 999px; cursor: pointer; }
  .be .chip-radio input { position: absolute; opacity: 0; width: 1px; height: 1px; margin: 0; }
  .be .chip-radio:has(input:checked) { background: var(--accent); border-color: var(--accent); color: #fff; }
  .be .chip-radio:has(input:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
  .be-formula { white-space: pre-wrap; overflow-wrap: anywhere; font-family: var(--mono); font-size: .85rem; background: var(--surface-2); border-radius: 12px; padding: 12px 14px; margin: 12px 0 0; }
  .be-save { display: flex; flex-wrap: wrap; gap: 8px; align-items: end; }
  .be-save label { flex: 1 1 200px; }
  .be-list { list-style: none; padding: 0; margin: 8px 0 0; }
  .be-list li { display: flex; flex-wrap: wrap; gap: 6px 10px; align-items: center; justify-content: space-between; padding: 10px 0; border-top: 1px solid var(--line); }
  .be-list li > div { min-width: 0; flex: 1 1 160px; overflow-wrap: anywhere; }
  .be-list small { color: var(--muted); display: block; }
</style>

<script>
  import { load, save } from '../../scripts/store.js';
  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  const form = document.getElementById('f') as HTMLFormElement;
  const IDS = ['rent', 'staff', 'other', 'p', 'cups', 'gm', 'vc', 'days'] as const;
  // 網址參數名稱
  const Q: Record<string, string> = { rent: 'rent', staff: 'staff', other: 'other', p: 'p', cups: 'c', gm: 'gm', vc: 'vc', days: 'd' };
  // 第 11 篇〈損益平衡〉的示範：固定成本 30 萬、客單價 150、毛利率 65%、26 天
  const DEMO: Record<string, string> = { rent: '', staff: '', other: '300000', p: '150', cups: '1', gm: '65', vc: '', days: '26', mode: 'gm' };
  const MAX = 10;

  const mode = () => (form.querySelector<HTMLInputElement>('input[name=mode]:checked')?.value === 'vc' ? 'vc' : 'gm');
  const val = (id: string) => $(id).value.trim();
  const fmt = (n: number, d = 0) => n.toLocaleString('zh-TW', { minimumFractionDigits: d, maximumFractionDigits: d });
  const ceil = (x: number) => Math.ceil(x - 1e-9);
  function err(id: string, msg: string) {
    document.getElementById(`${id}-err`)!.textContent = msg;
    $(id).setAttribute('aria-invalid', String(!!msg));
  }

  function values() {
    const v: Record<string, string> = { mode: mode() };
    IDS.forEach((id) => (v[id] = val(id)));
    return v;
  }

  function setValues(v: Record<string, string>) {
    IDS.forEach((id) => ($(id).value = v[id] ?? ''));
    form.querySelector<HTMLInputElement>(`input[name=mode][value=${v.mode === 'vc' ? 'vc' : 'gm'}]`)!.checked = true;
  }

  function update() {
    const m = mode();
    document.getElementById('gm-wrap')!.hidden = m !== 'gm';
    document.getElementById('vc-wrap')!.hidden = m !== 'vc';
    const v = values();
    const n = (id: string) => (v[id] === '' ? NaN : +v[id]);
    let bad = false, missing = false;
    const check = (id: string, ok: (x: number) => boolean, msg: string, required = true) => {
      const x = n(id);
      if (v[id] === '') { err(id, ''); if (required) missing = true; return; }
      const good = isFinite(x) && ok(x);
      err(id, good ? '' : msg);
      if (!good) bad = true;
    };
    for (const id of ['rent', 'staff', 'other']) check(id, (x) => x >= 0, '請輸入 0 以上的數字', false);
    check('p', (x) => x > 0, '客單價要大於 0');
    check('cups', (x) => x > 0 && x <= 50, '請輸入大於 0 的杯數，例如 1 或 1.2', false);
    check('days', (x) => x >= 1 && x <= 31, '每月營業天數請填 1 到 31');
    if (m === 'gm') { check('gm', (x) => x >= 1 && x <= 99, '毛利率請填 1 到 99 之間的百分比'); err('vc', ''); }
    else {
      const cupsN = isFinite(n('cups')) && n('cups') > 0 ? n('cups') : 1;
      check('vc', (x) => x >= 0 && (!(n('p') > 0) || x * cupsN < n('p')), n('p') > 0 && n('vc') * cupsN >= n('p') ? '每位客人的變動成本（每杯成本 × 杯數）要小於客單價，否則永遠打不平' : '請輸入 0 以上的數字');
      err('gm', '');
    }
    const fixed = ['rent', 'staff', 'other'].reduce((s, id) => s + (n(id) > 0 ? n(id) : 0), 0);
    if (!bad && fixed <= 0) missing = true;

    const out = document.getElementById('out')!;
    const fEl = document.getElementById('formula')!;
    const clearStats = () => ['o-rev', 'o-cust', 'o-cups'].forEach((id) => (document.getElementById(id)!.textContent = '–'));
    sync();
    if (bad) { clearStats(); fEl.hidden = true; out.innerHTML = '<b>有欄位需要修正</b>請看欄位下方的說明，修正後就會出現結果。'; return; }
    if (missing) { clearStats(); fEl.hidden = true; out.textContent = '填入數字就會在這裡出現結果。需要：至少一項固定成本、客單價、毛利率或每杯變動成本、每月營業天數。'; return; }

    const p = n('p'), days = n('days');
    const cupsBlank = v.cups === '';
    const cups = cupsBlank ? 1 : n('cups');
    let margin: number, marginLine: string, revLine: string, revenue: number;
    if (m === 'gm') {
      const gm = n('gm');
      margin = (p * gm) / 100; // 先乘後除，避免 0.65 的浮點誤差
      marginLine = `每位客人貢獻毛利 = ${fmt(p, 2).replace(/\.00$/, '')} × ${gm}% = ${fmt(margin, 2).replace(/\.?0+$/, '')} 元`;
      revenue = (fixed * 100) / gm;
      revLine = `每月需要的營業額 = ${fmt(fixed)} ÷ ${gm}% ≈ ${fmt(ceil(revenue))} 元`;
    } else {
      const vc = n('vc');
      margin = p - vc * cups;
      marginLine = `每位客人貢獻毛利 = ${fmt(p, 2).replace(/\.00$/, '')} − ${vc} × ${cups} 杯 = ${fmt(margin, 2).replace(/\.?0+$/, '')} 元`;
      revenue = (fixed / margin) * p;
    }
    const perMonth = fixed / margin;
    const perDayRaw = perMonth / days;
    const custDay = ceil(perDayRaw);
    const cupsDay = ceil(perDayRaw * cups);
    if (m === 'vc') revLine = `每月需要的營業額 = ${fmt(fixed / margin, 1)} 人 × ${fmt(p, 0)} 元 ≈ ${fmt(ceil(revenue))} 元`;
    document.getElementById('o-rev')!.textContent = `${fmt(ceil(revenue))} 元`;
    document.getElementById('o-cust')!.textContent = `${fmt(custDay)} 位`;
    document.getElementById('o-cups')!.textContent = `${fmt(cupsDay)} 杯`;
    out.innerHTML = `<b>每天約 ${fmt(custDay)} 位客人、約 ${fmt(cupsDay)} 杯才打平。</b>每月營業額約 ${fmt(ceil(revenue))} 元。${cupsBlank ? '每位客人杯數沒填，先以 1 杯計。' : ''}這只是不虧的門檻。`;
    const parts = ['rent', 'staff', 'other'].filter((id) => n(id) > 0).map((id) => fmt(n(id)));
    fEl.hidden = false;
    fEl.textContent = [
      `每月固定成本 = ${parts.join(' + ')} = ${fmt(fixed)} 元`,
      marginLine!,
      `損益平衡來客數 = ${fmt(fixed)} ÷ ${fmt(margin, 2).replace(/\.?0+$/, '')} ≈ ${fmt(ceil(perMonth))} 人／月`,
      `以每月營業 ${days} 天計 ≈ ${fmt(perDayRaw, 1)}，進位為每天 ${fmt(custDay)} 位客人`,
      `每天杯數 = ${fmt(perDayRaw, 2)} × ${cups} 杯 ≈ ${fmt(perDayRaw * cups, 1)}，進位為 ${fmt(cupsDay)} 杯`,
      revLine!,
    ].join('\n');
  }

  function sync() {
    const v = values();
    const p = new URLSearchParams();
    IDS.forEach((id) => { if (v[id] !== '' && !(id === (v.mode === 'vc' ? 'gm' : 'vc'))) p.set(Q[id], v[id]); });
    if (v.mode === 'vc') p.set('m', 'vc');
    const q = p.toString();
    history.replaceState(null, '', q ? `?${q}` : location.pathname);
  }

  // 情境：stc:breakeven = [{ id, name, at, values }]
  let scenarios: any[] = load('breakeven', []);
  if (!Array.isArray(scenarios)) scenarios = [];
  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
  function renderList() {
    const list = document.getElementById('sc-list')!;
    (document.getElementById('sc-save') as HTMLButtonElement).disabled = scenarios.length >= MAX;
    if (!scenarios.length) { list.innerHTML = '<li class="muted" style="border:0">還沒有存任何情境。</li>'; return; }
    list.innerHTML = scenarios.map((s) => {
      const v = s.values || {};
      const sum = [v.rent, v.staff, v.other].reduce((a: number, x: string) => a + (+x > 0 ? +x : 0), 0);
      const desc = [`固定成本 ${fmt(sum)} 元`, v.p ? `客單價 ${esc(v.p)} 元` : '', v.mode === 'vc' ? (v.vc ? `每杯成本 ${esc(v.vc)} 元` : '') : v.gm ? `毛利率 ${esc(v.gm)}%` : '', v.days ? `${esc(v.days)} 天` : ''].filter(Boolean).join('・');
      return `<li><div><b>${esc(s.name)}</b><small>${desc}・${new Date(s.at).toLocaleDateString('zh-TW')}</small></div>
        <span class="chips"><button class="btn btn-sm" type="button" data-load="${esc(s.id)}" aria-label="載入情境：${esc(s.name)}">載入</button>
        <button class="btn btn-sm" type="button" data-del="${esc(s.id)}" aria-label="刪除情境：${esc(s.name)}">刪除</button></span></li>`;
    }).join('');
  }
  const scMsg = (t: string) => (document.getElementById('sc-msg')!.textContent = t);
  document.getElementById('sc-save')!.addEventListener('click', () => {
    if (scenarios.length >= MAX) { scMsg(`最多存 ${MAX} 組，請先刪除一組。`); return; }
    const v = values();
    if (!IDS.some((id) => v[id] !== '')) { scMsg('先填一些數字再儲存。'); return; }
    const name = $('sc-name').value.trim() || `情境 ${scenarios.length + 1}`;
    scenarios.unshift({ id: Date.now().toString(36) + Math.random().toString(36).slice(2, 6), name, at: new Date().toISOString(), values: v });
    save('breakeven', scenarios);
    $('sc-name').value = '';
    scMsg(`已儲存「${name}」。`);
    renderList();
  });
  document.getElementById('sc-list')!.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button');
    if (!b) return;
    const s = scenarios.find((x) => x.id === (b.dataset.load || b.dataset.del));
    if (!s) return;
    if (b.dataset.load) {
      setValues(s.values || {});
      document.getElementById('demo-note')!.hidden = true;
      update();
      scMsg(`已載入「${s.name}」。`);
    } else if (confirm(`確定刪除情境「${s.name}」？`)) {
      scenarios = scenarios.filter((x) => x.id !== s.id);
      save('breakeven', scenarios);
      scMsg(`已刪除「${s.name}」。`);
      renderList();
    }
  });

  document.getElementById('demo')!.addEventListener('click', () => {
    setValues(DEMO);
    document.getElementById('demo-note')!.hidden = false;
    update();
  });
  document.getElementById('clear')!.addEventListener('click', () => {
    setValues({ mode: 'gm' });
    document.getElementById('demo-note')!.hidden = true;
    update();
  });
  document.getElementById('copy')!.addEventListener('click', async () => {
    const msg = document.getElementById('copy-msg')!;
    try { await navigator.clipboard.writeText(location.href); msg.textContent = '已複製連結。網址裡就是你填的數字，沒有任何資料上傳。'; }
    catch { msg.textContent = '無法自動複製，請直接複製瀏覽器網址列。網址裡就是你填的數字，沒有任何資料上傳。'; }
  });

  // 從網址還原：?other=300000&p=150&c=1&gm=65&d=26（m=vc 時用 vc）
  const qs = new URLSearchParams(location.search);
  IDS.forEach((id) => { const x = qs.get(Q[id]); if (x !== null && x.trim() !== '' && isFinite(+x)) $(id).value = x.trim(); });
  if (qs.get('m') === 'vc') form.querySelector<HTMLInputElement>('input[name=mode][value=vc]')!.checked = true;
  form.addEventListener('input', () => { document.getElementById('demo-note')!.hidden = true; update(); });
  form.addEventListener('change', update);
  renderList();
  update();
</script>
