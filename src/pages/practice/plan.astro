---
import Base from '../../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// 內容依第 05 篇的配方 A、排查表、「萃取階梯」與「稀釋測試」兩個練習設計
const days = [
  { d: '第 1–2 天', t: '沖得出同一杯', goal: '先求穩定，再求好喝。', steps: ['用通用配方（V60、15g 粉、240g 水、中細研磨）沖一杯，全程用計時器。', '記下總時間與粉床最後的樣子，喝的時候寫三個詞。', '隔天用完全相同的參數再沖一杯。'], pass: '兩杯的總時間相差 10 秒以內。差太多就先練注水，不要改參數。', tools: [['/tools/timer/', '沖煮計時器'], ['/tools/brew-log/', '沖煮紀錄']] },
  { d: '第 3–4 天', t: '萃取階梯', goal: '讓嘴巴記住萃取不足與萃取過度。', steps: ['同一支豆、同一粉水比與手法，只改研磨：明顯較細、平常、明顯較粗，各沖一杯。差距要大到三杯的總時間明顯不同（例如各差 30 秒以上），刻度要轉幾格依你的磨豆機而定。', '等降到約 40 至 50°C，三杯並排喝。', '分別找出哪一杯偏酸、鹹、薄，哪一杯偏苦、澀、舌根乾。'], pass: '不看杯子，能說出三杯各是哪一個研磨度。', tools: [['/tools/troubleshoot/', '味道排查']] },
  { d: '第 5 天', t: '稀釋測試', goal: '把「濃淡」和「味道的組成」分開。', steps: ['用 1:12 沖一杯偏濃的咖啡（例如 20g 粉、240g 水）。', '分成三杯：原液、加 20% 熱水、加 40% 熱水。', '三杯的萃取率完全相同，只有濃度不同。體會加水只會變淡，不會讓苦澀變甜。'], pass: '能用自己的話解釋：太淡該加粉，太酸該磨細，兩者不是同一件事。', tools: [['/tools/brew-log/', '沖煮紀錄']] },
  { d: '第 6–7 天', t: '找到這支豆子的甜蜜點', goal: '用一次只改一個變數的方法，定下你的基準配方。', steps: ['回到通用配方，照味道排查的方向只調研磨，每次小幅調整。', '找到甜感最明顯的那個研磨度之後，再用粉水比微調濃淡。', '把最後的參數完整寫下來，這就是你之後所有比較的基準。'], pass: '有一組寫得出來、隔天能重現的配方，而且你說得出它為什麼比第 1 天那杯好。', tools: [['/tools/brew-log/', '沖煮紀錄']] },
];
---
<Base
  fullTitle="手沖咖啡練習計畫 第 1 週：建立你的基準配方｜懂咖"
  description="一週的手沖咖啡練習：先沖出穩定的一杯，再用萃取階梯與稀釋測試訓練味覺，最後找到自己的基準配方。每天約 20 分鐘。"
>
  <div class="wrap narrow" data-pagefind-body>
    <header class="tool-head">
      <p class="eyebrow">練習計畫 · 手沖 · 第 1 週</p>
      <h1>建立你的基準配方</h1>
      <p class="lede">讀懂萃取原理和沖得出好咖啡之間，隔著幾十杯有紀錄的練習。這一週帶你把前七天走完。</p>
      <p class="meta"><span>7 天</span><span>每天約 20 分鐘</span><span>約需 200 至 250g 咖啡豆（買一包 250g）</span></p>
    </header>

    <aside class="callout">
      <span class="callout-icon" aria-hidden="true">🧰</span>
      <div class="callout-body">
        <p><b>開始前</b>：先讀完<a href={`${base}/lessons/brewing/`}>第 05 篇</a>的前六節。準備濾杯、手沖壺、磨豆機、電子秤，以及一支中淺焙的水洗豆（整週都用同一支）。</p>
      </div>
    </aside>

    {days.map((x, i) => (
      <section class="card plan-day">
        <p class="eyebrow">{x.d}</p>
        <h2 class="h-sm">{i + 1}. {x.t}</h2>
        <p class="muted" style="margin:0 0 10px">{x.goal}</p>
        <ol>{x.steps.map((s) => <li>{s}</li>)}</ol>
        <p class="pass"><b>過關標準</b>　{x.pass}</p>
        <p class="path-links">{x.tools.map(([h, l]) => <a href={`${base}${h}`}>{l}</a>)}</p>
      </section>
    ))}

    <section class="card plan-day">
      <h2 class="h-sm">這一週結束時，你應該有</h2>
      <ul>
        <li>至少 8 筆沖煮紀錄</li>
        <li>一組自己的基準配方</li>
        <li>分辨萃取不足與萃取過度的把握</li>
      </ul>
      <label class="check-inline" style="margin-top:8px"><input type="checkbox" id="plan-done" /> 我做完第 1 週了</label>
    </section>

    <h2 class="section-title">接下來</h2>
    <p>第 1 週之後的內容還沒有寫。接下來的方向會是換豆子（不同產區與烘焙度怎麼調）、換濾杯，以及冰手沖。</p>
    <p>在那之前，可以用同樣的方法換一支豆子再做一遍，或接著讀<a href={`${base}/lessons/tasting/`}>第 04 篇</a>練習描述風味。</p>
  </div>
</Base>

<script>
  import { load, save } from '../../scripts/store.js';
  const c = document.getElementById('plan-done') as HTMLInputElement;
  c.checked = load('plan:pourover:1', false);
  c.addEventListener('change', () => save('plan:pourover:1', c.checked));
</script>
