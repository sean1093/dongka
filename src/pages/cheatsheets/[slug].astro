---
import Base from '../../layouts/Base.astro';
import RefNav from '../../components/RefNav.astro';
import { sheets } from '../../data/cheatsheets.js';
import { lessons } from '../../data/lessons.js';
import { site } from '../../data/site.js';
import { breadcrumb, article } from '../../lib/seo.js';

export function getStaticPaths() {
  return sheets.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const origin = (Astro.site?.origin || '').replace(/\/$/, '');
const src = s.lessons.map((id: string) => lessons.find((l) => l.id === id)).filter(Boolean);
const path = `${base}/cheatsheets/${s.slug}/`;
---
<Base
  fullTitle={`${s.title}${s.question.length <= 22 ? `：${s.question.replace(/？$/, '')}` : '：一頁看完'}｜懂咖`}
  description={`${s.question}${s.intro}`}
  ogType="article"
  shareText={`${s.title}｜${s.question}`}
  jsonld={[breadcrumb(origin, [['懂咖', `${base}/`], ['速查表', `${base}/cheatsheets/`], [s.title, path]]), article(origin, { headline: s.title, description: s.question, path })]}
>
  <div class="wrap narrow" data-pagefind-body>
    <header class="tool-head">
      <p class="eyebrow"><a href={`${base}/cheatsheets/`}>速查表</a></p>
      <h1 data-pagefind-weight="8">{s.title}</h1>
      <p class="lede">{s.question}</p>
      <p class="muted">{s.intro}</p>
      <button type="button" class="btn btn-sm no-print" onclick="window.print()">列印這一頁</button>
    </header>
    <article class="prose sheet">
      {s.blocks.length > 3 && <p class="path-links sheet-jump" data-pagefind-ignore>{s.blocks.map((b: any, i: number) => <a href={`#b${i + 1}`}>{b.heading}</a>)}</p>}
      {s.blocks.map((b: any, i: number) => (
        <section id={`b${i + 1}`} class="sheet-sec">
          <div class="sheet-head">
            <h2 class="h-sm">{b.heading}</h2>
            <button type="button" class="btn btn-sm" data-section-share={`b${i + 1}`} aria-label={`傳這一段：${b.heading}`} data-pagefind-ignore>傳這一段</button>
          </div>
          {b.type === 'table' && (
            <div class="table-wrap">
              <table class:list={{ stack: b.head.length >= 3 }}>
                <thead><tr>{b.head.map((h: string) => <th>{h}</th>)}</tr></thead>
                <tbody>{b.rows.map((r: string[]) => <tr>{r.map((c, n) => <td data-label={b.head[n]}>{c}</td>)}</tr>)}</tbody>
              </table>
            </div>
          )}
          {b.type === 'steps' && <ol>{b.items.map((x: string) => <li>{x}</li>)}</ol>}
          {b.type === 'list' && <ul class="points">{b.items.map((x: string) => <li>{x}</li>)}</ul>}
        </section>
      ))}
      {s.note && <p class="muted">{s.note}</p>}
      <p class="src" data-pagefind-ignore>依據：{src.map((l: any, n: number) => <>{n > 0 && '、'}<a href={`${base}/lessons/${l.slug}/`}>第 {l.id} 篇　{l.title}</a></>)}。最後查核 {site.updated}。懂咖 Dongka</p>
    </article>
    <RefNav current="cheatsheets" />
  </div>
</Base>
